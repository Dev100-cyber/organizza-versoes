{
  "name": "Organizza",
  "short_name": "Organizza",
  "description": "Cada arquivo no lugar certo. Cada cliente em dia.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#16181d",
  "theme_color": "#16181d",
  "icons": [
    { "src": "/icone-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "arquivos", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "*/*"] }
      ]
    }
  }
}
